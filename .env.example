# Write token for Spectre / agent heartbeats (POST /api/agent-ops/status and /api/live)
OPS_WRITE_TOKEN=replace-with-a-long-random-secret

# Upstash Redis REST — required on Vercel (serverless memory does not persist).
# Local/dev falls back to an in-memory Map when these are unset.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# --- Content Review (/review) ---
# Single n8n webhook for all review actions; body.action = approve | reject | kill
# | confirm_tone | mark_manual_done | mark_stale | pick_title, keyed by packageId. Leave both unset for MOCK
# mode (actions only update the dashboard's own cache; nothing is sent).
# Example: https://paranormaltours.duckdns.org/webhook/pt-content/review
N8N_REVIEW_WEBHOOK_URL=
# Shared secret: X-PT-Signature = bare hex HMAC-SHA256(secret, "<X-PT-Timestamp>.<rawBody>").
N8N_WEBHOOK_SECRET=
# Founder passcode for /review and the action routes. Unset = unprotected banner.
REVIEW_ADMIN_PASSWORD=
# Optional: separate secret for signing the review session cookie (defaults to the passcode).
REVIEW_SESSION_SECRET=
# Optional: force example-data seeding on (1) or off (0). Default: on only in mock mode.
CONTENT_REVIEW_MOCK_SEED=
